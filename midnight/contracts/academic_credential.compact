// AcadVerify — academic credential contract (Midnight / Compact)
//
// VALIDATED: compiles with Compact compiler 0.34.0 (language version 0.26.0,
// runtime 0.19.0). Produces 4 circuits, prover+verifier keys, and a TypeScript
// contract API. See docs/smart-contract.md for the full design rationale.
//
//   compact compile midnight/contracts/academic_credential.compact \
//                   midnight/contracts/managed/academic_credential
//
// PRIVACY MODEL (see docs/data-model.md):
//   Ledger holds commitments and flags only. Credential fields live in the
//   witness — they are PLONK private inputs and never enter the public
//   transcript. proveCredential returns ONLY DisclosedClaim, which by
//   construction cannot contain studentId.

pragma language_version >= 0.26;

import CompactStandardLibrary;

// Full credential. Supplied as a witness — NEVER written to the ledger.
export struct CredentialData {
  studentId: Bytes<32>,
  issuerPk: Bytes<32>,
  institutionId: Bytes<32>,
  degreeCode: Uint<32>,
  graduationYear: Uint<16>,
  gpaTimes100: Uint<16>
}

// What a verification reveals. studentId is deliberately absent: the type
// system makes non-disclosure of the holder's identity unrepresentable.
export struct DisclosedClaim {
  institutionId: Bytes<32>,
  degreeCode: Uint<32>,
  graduationYear: Uint<16>,
  gpaTimes100: Uint<16>
}

// ---- Public ledger state (visible on-chain) --------------------------------
export ledger issuers: Set<Bytes<32>>;                  // authorized issuer public keys
export ledger credentials: Map<Bytes<32>, Bytes<32>>;   // credentialId -> commitment
export ledger revoked: Set<Bytes<32>>;                  // revoked credentialIds
export sealed ledger platformOwner: Bytes<32>;          // set once at deployment

// ---- Witnesses (private, supplied locally, never published) ----------------
witness localSecretKey(): Bytes<32>;
witness credentialFields(): CredentialData;
witness credentialSalt(): Bytes<32>;

// Derive a public key from a secret key. Domain-separated so this key can
// never collide with a commitment or nullifier from another context.
circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "acadverify:pk:"), sk]);
}

constructor() {
  platformOwner = disclose(publicKey(localSecretKey()));
}

// Platform owner authorizes a university's issuer key.
export circuit authorizeIssuer(issuerPk: Bytes<32>): [] {
  assert(publicKey(localSecretKey()) == platformOwner, "not platform owner");
  issuers.insert(disclose(issuerPk));
}

// Issue: publish a commitment to the credential without revealing any field.
// persistentCommit is SHA-256 over the Compact encoding of CredentialData,
// blinded by credentialSalt. It clears witness taint, so the commitment may be
// written to the ledger without disclose().
export circuit issue(credentialId: Bytes<32>): [] {
  const pk = publicKey(localSecretKey());
  assert(issuers.member(disclose(pk)), "issuer not authorized");
  assert(!credentials.member(disclose(credentialId)), "duplicate credential");
  const commitment = persistentCommit<CredentialData>(credentialFields(), credentialSalt());
  credentials.insert(disclose(credentialId), commitment);
}

// Revoke. One-way: there is no un-revoke (see docs/smart-contract.md).
export circuit revokeCredential(credentialId: Bytes<32>): [] {
  const pk = publicKey(localSecretKey());
  assert(issuers.member(disclose(pk)), "issuer not authorized");
  assert(credentials.member(disclose(credentialId)), "unknown credential");
  revoked.insert(disclose(credentialId));
}

// Prove a credential is valid, non-revoked, and from an authorized issuer,
// revealing only the consented fields. Holding the correct witness data IS the
// proof of authenticity: a tampered field yields a different commitment and
// the assert fails, so no proof can be produced at all.
export circuit proveCredential(credentialId: Bytes<32>, revealGpa: Boolean): DisclosedClaim {
  const fields = credentialFields();
  const commitment = persistentCommit<CredentialData>(fields, credentialSalt());
  assert(credentials.member(disclose(credentialId)), "unknown credential");
  assert(credentials.lookup(disclose(credentialId)) == commitment, "commitment mismatch");
  assert(!revoked.member(disclose(credentialId)), "credential revoked");
  assert(issuers.member(disclose(fields.issuerPk)), "issuer not authorized");
  return disclose(DisclosedClaim {
    institutionId: fields.institutionId,
    degreeCode: fields.degreeCode,
    graduationYear: fields.graduationYear,
    gpaTimes100: revealGpa ? fields.gpaTimes100 : 0
  });
}
