# AcadVerify — local development environment variables
# Copy to .env:  cp .env.example .env
# NEVER commit .env. Real seeds/keys come from AWS Secrets Manager.
# Versions and endpoints: docs/midnight-stack.md

# --- Midnight network -------------------------------------------------------
# undeployed (local devnet) | preview (demo target) | preprod
MIDNIGHT_NETWORK_ID=undeployed

# Local devnet (docker compose). Inside Docker use service names, not localhost:
#   http://node:9944 · http://indexer:8088 · http://proof-server:6300
MIDNIGHT_NODE_URL=http://localhost:9944
MIDNIGHT_INDEXER_URL=http://localhost:8088/api/v4/graphql
MIDNIGHT_INDEXER_WS=ws://localhost:8088/api/v4/graphql/ws
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Preview network (uncomment for the demo target):
# MIDNIGHT_NETWORK_ID=preview
# MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
# MIDNIGHT_INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Deployed contract address; filled in after deploy, committed per network to
# midnight/deployments/<networkId>.json
CONTRACT_ADDRESS=

# Compiled Compact artifacts the zkConfigProvider loads at runtime.
# Produced by: compact compile midnight/contracts/academic_credential.compact \
#                              midnight/contracts/managed/academic_credential
MIDNIGHT_ZK_CONFIG_PATH=./midnight/contracts/managed/academic_credential

# Private state store (LevelDB): credential fields + salts.
# This is the privacy boundary of the product — lost means credentials can never
# be proven again; leaked means commitments become openable. See docs/data-model.md
MIDNIGHT_PRIVATE_STATE_PATH=./.private-state

# Platform-owner / issuer wallet seed. LOCAL DEVNET ONLY.
# A funded Preview seed must come from Secrets Manager, never from this file.
MIDNIGHT_WALLET_SEED=

# --- Chain-service (Node 22 + Midnight.js) ---------------------------------
CHAIN_SERVICE_URL=http://localhost:8090
CHAIN_SERVICE_PORT=8090

# --- Local AWS stand-ins ----------------------------------------------------
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=acadverify
S3_SECRET_KEY=acadverify123
S3_BUCKET=acadverify-dev
AWS_REGION=us-east-1

# --- Backend ----------------------------------------------------------------
API_PORT=8080

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Cross-Chain stretch track ONLY (not part of the primary demo) ----------
# RPC_URL=
# CHAIN_ID=
