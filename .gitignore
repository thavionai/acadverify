# Environment / secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Node
node_modules/
.next/
out/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Hardhat / blockchain
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/coverage/
coverage.json

# Midnight / Compact build output — regenerated by `compact compile`.
# NOTE: compiler/contract-info.json is deliberately NOT ignored. It records each
# circuit's arguments and result type, i.e. exactly what the contract can
# reveal, so it is committed and diffed in review as a privacy surface change.
# See docs/smart-contract.md and docs/deployment.md.
midnight/**/build/
midnight/**/managed/**/keys/
midnight/**/managed/**/zkir/
midnight/**/managed/**/contract/
midnight/chain-service/.private-state/
.private-state/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local data volumes
data/local/
